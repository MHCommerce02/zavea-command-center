# Copy this file to .env.local and fill in the real values from your
# Supabase project settings (Project Settings > API).
# .env.local is gitignored and must never be committed.

# Public -- safe to expose client-side. Protected entirely by Row Level
# Security on the database; this is Supabase's intended client-side model.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# NEVER add SUPABASE_SERVICE_ROLE_KEY here or anywhere that ships to the
# browser. The service-role key bypasses RLS entirely and must only ever
# live in a trusted server environment (e.g. a CI secret store), never in
# this repo, never in NEXT_PUBLIC_* variables, never in client code.
